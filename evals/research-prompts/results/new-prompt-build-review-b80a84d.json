  "supported_execution_changes": [
    {
      "finding": "Qualification/acceptance ordering",
      "evidence": "run.sh invokes unchanged gate --accept on fetched artifact; nonzero exits before materialization/scoring. Worker accept.log confirms acceptance. No reference computation in this entrypoint precedes acceptance."
    },
    {
      "finding": "Majority accuracy measures actual split predictions",
      "evidence": "Majority class chosen from train prevalence; each split computes mean(label == fixed majority class). The old training-prevalence proxy is no longer used as eval accuracy."
    },
    {
      "finding": "Calendar and identity controls are distinct",
      "evidence": "Calendar logistic regression fits approval FY and cyclical month on train only. The old country-by-year table is separately checked and reported as 100% fallback to identity on eval/holdout."
    },
    {
      "finding": "Paired uncertainty and comparable rows",
      "evidence": "Model/reference arrays share each split frame; country clusters are resampled jointly for both predictions. Fixed 2000-resample/seed scheme and per-year AUC/Brier are recorded."
    },
    {
      "finding": "Existing runner and holdout boundary",
      "evidence": "Bundled train.py hash matches existing runner manifest. Trusted scorer executes it on public train/eval workdir, then invokes predict_proba on private holdout in scorer; no new substitute runner or holdout copied into agent workdir."
    }
  ],
  "remaining_limits": [
    {
      "finding": "Historical availability remains unresolved",
      "evidence": "Original artifact and descriptor are unchanged. The prior Codex audit of current-vintage attributes/ratings and future exclusion has not been resolved by a scoring-only job. Mechanical acceptance does not establish those scientific claims."
    },
    {
      "finding": "Holdout already partially exposed",
      "evidence": "The manifest says design frozen before any holdout number existed, but score_holdout.py EXPECTED contains the previously reported identity holdout AUC. New model scoring may be first measurement, but the holdout as a whole was not unseen. No holdout-based parameter fitting observed in this source."
    },
    {
      "finding": "Bootstrap scope",
      "evidence": "Country-cluster intervals condition on these fitted models and split design; they do not measure training/model-selection variability or remove historical information-set uncertainty."
    },
    {
      "finding": "Recipe cleanup pattern",
      "evidence": "run.sh uses rm -rf \"$WORK\" with WORK fixed to /tmp/workdir on the ephemeral worker. No coordinator cleanup observed, but an explicit ownership check/path would better match the repository cleanup rule."
    }
