.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.factory/
config/local.json
data/
artifacts/
*.csv
# The qualification gate's fixtures are small synthetic extracts and must be versioned.
!skills/dataset-qualification/fixtures/**/*.csv
*.parquet
*.arrow
*.zip
*.tar
*.tar.gz
*.tar.zst
*.gz
*.part
*.pem
*.key

# Never commit credentials, live databases, logs or archives from the deployment export.
# The snapshot script refuses these too; this is the second line of defence.
deployment/**/*.env
deployment/**/*.db
deployment/**/*.sqlite*
deployment/**/*.key
deployment/**/*.pem
deployment/**/*.token
deployment/**/*.log
deployment/**/*.zip
deployment/**/*.tar*
