# Reference only: factory does NOT load this file or the Hermes dashboard .env.
# On Scout use: sh scripts/scout-factory doctor --require-worker-credentials
# It exports the _FILE paths below for terminal and cron without shell startup files.
# Never commit actual credentials.
HCLOUD_TOKEN=
FACTORY_GITHUB_TOKEN=
# Or point to private files with mode 0600:
HCLOUD_TOKEN_FILE=/opt/data/.secrets/hetzner.token
FACTORY_GITHUB_TOKEN_FILE=/opt/data/.secrets/github-staging.token
# Optional for ordinary gh/git operations; worker upload uses FACTORY_GITHUB_TOKEN.
GH_TOKEN=
